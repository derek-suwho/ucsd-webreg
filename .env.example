# Local development only; replace both placeholders with the same generated secret.
POSTGRES_PASSWORD=<generated-high-entropy-local-password>
DATABASE_URL=postgresql://webreg:<generated-high-entropy-local-password>@127.0.0.1:5432/webreg
# Production Railway values must be separate external managed-PostgreSQL URLs:
# Prisma requires both exact TLS parameters; sslaccept=strict verifies the public CA and hostname.
# DATABASE_URL=postgresql://web_runtime:<secret>@db.example.com:5432/webreg?sslmode=require&sslaccept=strict
# MIGRATION_DATABASE_URL=postgresql://web_migrator:<secret>@db.example.com:5432/webreg?sslmode=require&sslaccept=strict
# Never expose MIGRATION_DATABASE_URL to web or worker services.
MIGRATION_DATABASE_URL=
CONTACT_EMAIL=webreg-ops@example.invalid
# Required explicitly in production. Live TSS ingestion stays disabled; legacy-soc
# is limited to the built-in pre-FA26 allowlist for local/manual use.
CATALOG_SOURCE=fixture
# Whole-term snapshot safety limits. Defaults shown; raise only after measuring.
CATALOG_MAX_COURSES=20000
CATALOG_MAX_SECTIONS=100000
CATALOG_MAX_SNAPSHOT_BYTES=33554432
# Canonical web/Auth.js origin. If AUTH_URL is set by the platform, it must match.
APP_ORIGIN=http://localhost:3000
# NextAuth v5 (Google OAuth). In Google Cloud console, set the
# authorized redirect URI to: http://localhost:3000/api/auth/callback/google
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production Railway: an external managed Redis endpoint using rediss:// is
# mandatory. Set proxy hops to the exact trusted reverse-proxy count.
REDIS_URL=redis://127.0.0.1:6379
TRUSTED_PROXY_HOPS=0
# Set true only when every production request is served exclusively through TLS.
# Reconcile this app header with the TLS edge's HSTS policy to avoid duplicates.
ENABLE_HSTS=false
