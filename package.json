{
  "name": "ucsd-webreg",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:ci": "node scripts/verify-ci-services.mjs && vitest run",
    "seed:demo": "tsx scripts/seed-dev.ts",
    "typecheck": "tsc -b",
    "typecheck:clean": "tsc -b --clean && tsc -b --force --pretty false",
    "lint": "corepack npm run lint -w @webreg/web",
    "lint:ci": "corepack npm exec --workspace @webreg/web -- eslint . --max-warnings=0",
    "build:web": "corepack npm run build -w @webreg/web",
    "build:worker": "corepack npm run build -w @webreg/worker",
    "verify:ci-services": "node scripts/verify-ci-services.mjs",
    "verify:ci-workflow": "node scripts/verify-ci-workflow.mjs",
    "verify": "corepack npm run typecheck:clean && corepack npm run lint && corepack npm run build:web && corepack npm run build:worker && corepack npm test"
  },
  "dependencies": {
    "@prisma/client": "7.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "puppeteer-core": "24.37.5",
    "prisma": "6.12.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "undici": "7.29.0"
  },
  "packageManager": "npm@11.18.0"
}
